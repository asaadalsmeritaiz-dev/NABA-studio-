# ==============================================================================
# Naba AI Video Studio — Environment Configuration Example
# ==============================================================================

# Core Gemini AI API key (Server-side only; injected automatically in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL of the running studio (used for Naba Academy callback metadata)
APP_URL="http://localhost:3000"

# Local SQLite database file path (zero-cost local development default)
DATABASE_PATH="./data/naba_studio.sqlite"

# Storage directory for uploaded lesson materials, audio tracks, and exported MP4s
STORAGE_DIR="./storage"

# Optional external GPU / Cloud Lip-Sync Provider Endpoints (Mode B / Mode C)
# Leave blank to run in transparent Mode A (Lightweight Local deterministic studio)
SADTALKER_ENDPOINT=""
MUSETALK_ENDPOINT=""
HEYGEN_API_KEY=""
DID_API_KEY=""

# Optional external Generative Video Provider Endpoints (Wan 2.1 / LTX-Video)
WAN_VIDEO_ENDPOINT=""
LTX_VIDEO_ENDPOINT=""

# Explicit opt-in required before enabling paid Gemini generative video (gemini-omni-1.2-flash)
ENABLE_PAID_GEMINI_MODELS="false"

# Optional Naba Academy LMS Integration Webhook & Shared Secret
NABA_ACADEMY_API_URL=""
NABA_ACADEMY_WEBHOOK_SECRET=""

# Optional administrator login for the seeded studio workspace
STUDIO_ADMIN_PASSCODE=""

# Required for first-run public workspace claiming unless STUDIO_ADMIN_PASSCODE is set.
# Generate a random private value of at least 16 characters and share it only with the workspace owner.
STUDIO_WORKSPACE_CLAIM_CODE=""
